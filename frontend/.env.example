# Copy to `.env` for local development. Never commit `.env`.
#
# Every VITE_-prefixed variable is embedded in the browser bundle and is
# public. Never put secrets here (API keys, credentials, signing keys).
# Backend secrets live in backend/.env — see docs/environments.md.

# Public URL of the Django GraphQL endpoint (required).
VITE_GRAPHQL_URL=http://localhost:8000/graphql/

# Google OAuth client id (Sprint 1, S1-004), optional. Not secret - a
# Google OAuth client id identifies the app, it does not authenticate it -
# and must match backend/.env's GOOGLE_OAUTH_CLIENT_ID. Leave unset to
# disable the "Continue with Google" button. See docs/environments.md.
# VITE_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
