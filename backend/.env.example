# Backend environment configuration template.
#
# Copy to `backend/.env` for local development and edit. `.env` is ignored by
# Git — never commit it. Every value below is a placeholder.
#
# Real environment variables always override values in `.env`. Deployed
# environments (development / staging / production) must NOT use a `.env`
# file: inject these variables from the platform's secret management.
# See docs/environments.md.

# --- Environment ---
# local | development | staging | production
# `local` requires DJANGO_SETTINGS_MODULE=config.settings.local (the default).
# The others require DJANGO_SETTINGS_MODULE=config.settings.production.
# Each side refuses the other's names. `ci` (set only by GitHub Actions) uses
# the local settings and is rejected by production, so CI can never be deployed.
ENVIRONMENT=local

# --- Django ---
# SECRET: required everywhere; there is no default. Generate a real value with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Deployed environments reject placeholders and keys shorter than 50 characters.
DJANGO_SECRET_KEY=change-me
# Local default is True. Deployed environments refuse to start if this is True.
DJANGO_DEBUG=True
# Comma-separated hostnames. Local falls back to localhost,127.0.0.1 if unset.
# Required in deployed environments; wildcards are rejected.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Authentication (Sprint 1) ---
# SECRET: signs JWT access tokens (identity/tokens.py). Required everywhere;
# no default. Deliberately a different value from DJANGO_SECRET_KEY - see
# config/settings/base.py. Generate the same way as DJANGO_SECRET_KEY above.
# Deployed environments reject placeholders, keys shorter than 50 characters,
# and reusing DJANGO_SECRET_KEY's value.
DJANGO_JWT_SIGNING_KEY=change-me-too
# Optional. Access token lifetime in minutes (default 15) and refresh
# session lifetime in days (default 30).
# ACCESS_TOKEN_LIFETIME_MINUTES=15
# REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Google OAuth/OIDC (Sprint 1, S1-004) ---
# Optional: the `googleLogin` mutation always fails closed if unset (see
# identity/google_oauth.py), so this can be left unset until Google
# sign-in is actually needed. The OAuth client id from a Google Cloud
# project ("APIs & Services" > "Credentials" > OAuth 2.0 Client IDs, type
# "Web application"). Not secret - it must also be set as
# frontend/.env's VITE_GOOGLE_OAUTH_CLIENT_ID (the same value). Configure
# the frontend's origin(s) (e.g. http://localhost:5173) as an "Authorized
# JavaScript origin" on that same OAuth client - this flow needs no
# redirect URI and there is deliberately no client secret setting; see
# identity/google_oauth.py's module docstring for why.
#
# The variable name is exactly GOOGLE_OAUTH_CLIENT_ID and nothing is
# inferred from any other name. A differently-named variable (e.g.
# CLIENT_ID or GOOGLE_CLIENT_ID) is silently ignored - there is no
# default to complain about - and Google sign-in then fails closed at
# runtime with "Could not sign in with Google." instead of at startup,
# so spell it exactly as written below.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Outgoing email (password reset, account activation) ---
# Everything the two emailed flows need. The messages are plain text over
# SMTP: they carry a single-use link that resets a password or confirms an
# address, so they need no HTML, no remote images and no tracking (see
# identity/email.py's module docstring for the reasoning). Any provider that
# speaks SMTP works; EMAIL_BACKEND is a plain Django setting, so moving to a
# hosted service later is a settings change, not a code change.
#
# EMAIL_BACKEND - required in every deployed environment, and it must be a
# backend that actually *sends*. config/settings/production.py refuses to
# start on the console backend: that one prints the message (reset link
# included) to the log instead of mailing it, so every reset request would
# report success while the link reached nobody.
#   local development : django.core.mail.backends.console.EmailBackend
#                       (default; prints the link to the terminal, so the
#                       whole flow is clickable by hand with no mail account)
#   deployed          : django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# SMTP server. EMAIL_HOST/EMAIL_PORT/EMAIL_USE_TLS all have defaults
# (localhost, 587, TLS on) and are deliberately *not* guarded - they are the
# ordinary knobs of every SMTP server. For implicit TLS on 465 instead, set
# EMAIL_PORT=465 and EMAIL_USE_TLS=False, which Django expresses as
# SSL-on-connect.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
#
# SECRET: the mailbox's app password, never the account's real password. A
# hosted provider issues one for exactly this purpose; a Google account uses
# an app password. Required in every deployed environment.
# EMAIL_HOST_USER=mailer@example.com
# EMAIL_HOST_PASSWORD=app-only-mail-password
#
# The address the messages claim to come from. Required in every deployed
# environment, and it must not be left at the local default: SPF/DKIM are
# checked against this domain, so a wrong or placeholder sender is how
# password-reset mail ends up in spam.
# DEFAULT_FROM_EMAIL=no-reply@example.com
#
# The public origin of the browser app, with no trailing slash. The reset and
# activation links are links *into the frontend*, not into the API, so this
# is what decides where a user lands after clicking one. Required in every
# deployed environment and must be https:// there - an http:// link would
# hand the single-use token in it to the network in the clear. Local
# development defaults to the Vite dev server (config/settings/local.py).
# Set it explicitly to test the flow from a phone or another host, e.g.
# FRONTEND_URL=http://192.168.1.10:5173
# FRONTEND_URL=https://app.example.com
#
# How long an emailed link stays usable. Both are deliberately short - the
# link is only needed at the moment its owner clicks it, and it travels
# through a mail client's search index, a shared inbox and any chat app
# somebody forwards it into. Minutes for a password reset, hours for an
# account activation.
# PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=60
# ACTIVATION_TOKEN_LIFETIME_HOURS=48

# --- Cache ---
# Shared cache for the security state that every process has to agree on:
# the Google ID-token replay check (identity/google_oauth.py) and the
# authentication rate limits (identity/throttling.py). A per-process
# in-memory cache is a per-process *copy* of that state, so with more than
# one worker the second process would admit what the first one blocked.
# Required in every deployed environment; config/settings/production.py
# refuses to start without it, and refuses to start if it resolves to a
# local in-memory backend. Local development may leave it unset - with one
# process, the in-memory cache is correct. See config/settings/base.py.
# CACHE_URL=redis://localhost:6379/1

# --- Attachment storage (Sprint 2, S2-007) ---
# Optional. Which Django storage backend holds attachment bytes
# (ideas/storage.py) - the database only ever holds metadata and this key.
# Left unset, local development and CI use the filesystem backend that
# ships with Django, writing under backend/media/attachments/. No
# object-storage backend (S3, GCS, ...) is installed or configured by this
# project yet - setting this to one without also installing its driver
# package (e.g. django-storages) and configuring that backend's own
# settings will fail at startup, not silently fall back to the filesystem.
# ATTACHMENTS_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
#
# Optional. The largest attachment this deployment accepts, in bytes.
# Defaults to 10 MB (10485760). Enforced server-side
# (ideas/attachments.py); a client-side check is a courtesy only.
# ATTACHMENT_MAX_UPLOAD_BYTES=10485760

# --- Database ---
# SECRET (contains the password): required everywhere; there is no default.
#   postgresql://<db_user>:<db_password>@<host>:<port>/<db_name>
# Append ?sslmode=require for databases that need TLS. See backend/README.md
# for creating the local role and database.
DATABASE_URL=postgresql://user:password@localhost:5432/database
# Optional. Seconds to keep connections open (0 = close per request).
# Defaults: 0 local, 60 deployed.
# DATABASE_CONN_MAX_AGE=

# --- CORS / CSRF ---
# Comma-separated browser origins (scheme://host[:port], no path, no wildcard).
# Local defaults to the Vite dev server (http://localhost:5173) if unset.
# Deployed environments require explicit https:// origins.
# CORS: origins allowed to call /graphql/ from the browser.
# CSRF: origins trusted for CSRF-protected requests (e.g. the Django admin).
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Deployed environments only ---
# Redirect HTTP to HTTPS. Defaults to True; only disable if TLS is already
# terminated and redirected by a proxy you control.
# DJANGO_SECURE_SSL_REDIRECT=True
# Trust the proxy's X-Forwarded-Proto header to detect HTTPS. Defaults to
# False. Enable ONLY behind a TLS-terminating proxy that sets the header itself
# and strips any client-supplied value, and then usually alongside the
# redirect above (otherwise it redirects forever).
# DJANGO_TRUST_X_FORWARDED_PROTO=False
# HTTP Strict Transport Security max-age in seconds. Defaults to 31536000 (1
# year) when ENVIRONMENT=production and 3600 (1 hour) for development and
# staging; 0 disables. Browsers cache the policy - see docs/environments.md.
# DJANGO_SECURE_HSTS_SECONDS=3600
# Both default to False and affect every subdomain / are effectively permanent.
# Preload requires includeSubDomains and at least a 1-year max-age.
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_SECURE_HSTS_PRELOAD=False
